#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
staged=$(git diff --cached --name-only --diff-filter=ACMR)
ignored=$(printf '%s\n' "$staged" | git check-ignore --no-index --stdin || true)
if [ -n "$ignored" ]; then
    echo "pre-commit: ignored paths are staged:" >&2
    printf '%s\n' "$ignored" >&2
    exit 1
fi
if command -v uv >/dev/null 2>&1; then
    uv run --quiet tools/episteme.py check
else
    python3 tools/episteme.py check
fi
